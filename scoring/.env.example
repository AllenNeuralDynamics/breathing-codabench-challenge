# Copy to .env for local runs: `uv run --env-file scoring/.env python
# scoring/score.py ...` (uv loads it directly; nothing in the scoring
# package reads .env itself). The Docker image bakes its own default in via
# `ENV` in scoring/Dockerfile -- update both places when this location
# changes.
#
# s3://{bucket}/{prefix}/{clip_id}.parquet holds each clip's ground-truth
# thermistor signal.
GROUND_TRUTH_S3_URI=
